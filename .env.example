# Endpoint OpenAI-compatible do LLM local (llama.cpp servido pelo ODS).
# Ajuste para o endereco do seu LLM local.
# A porta 3000 e o Open WebUI, nao a API.
QWEN_ENDPOINT=http://127.0.0.1:8080/v1
QWEN_MODEL=local-model

# Armazenamento local
DUCKDB_PATH=./data/anvisa.duckdb

# Sincronizacao dos datasets publicos.
# Horario fixo (HH:MM), nao intervalo: a GPU serializa as chamadas ao Qwen, entao
# os syncs dos projetos locais sao escalonados de madrugada. Este fica as 03:20.
SYNC_HORA_LOCAL=03:20

# Cliente LLM
QWEN_TIMEOUT_SEGUNDOS=120
QWEN_MAX_TENTATIVAS=3

LOG_LEVEL=INFO
