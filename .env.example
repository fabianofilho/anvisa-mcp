# Endpoint do seu LLM local, no formato OpenAI-compatible.
#   llama.cpp (llama-server): http://127.0.0.1:8080/v1
#   Ollama:                   http://127.0.0.1:11434/v1
#   LM Studio:                http://127.0.0.1:1234/v1
QWEN_ENDPOINT=http://127.0.0.1:8080/v1

# Nome do modelo carregado. O llama.cpp e o LM Studio aceitam qualquer nome
# quando ha um unico modelo; o Ollama exige o nome exato (ex.: qwen3:8b).
QWEN_MODEL=local-model

# Armazenamento local
DUCKDB_PATH=./data/anvisa.duckdb

# Sincronizacao dos datasets publicos.
# Horario fixo (HH:MM) em vez de intervalo relativo. Um LLM local costuma
# atender uma chamada por vez, entao vale rodar o sync de madrugada e, se voce
# tiver mais de um projeto assim, escalonar os horarios entre eles.
SYNC_HORA_LOCAL=03:20

# Cliente LLM
QWEN_TIMEOUT_SEGUNDOS=120
QWEN_MAX_TENTATIVAS=3

LOG_LEVEL=INFO
